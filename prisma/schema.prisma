generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model College {
  id               String            @id @default(uuid())
  name             String
  location         String
  state            String
  city             String
  establishedYear  Int
  collegeType      CollegeType
  rating           Decimal           @db.Decimal(2, 1)
  totalFees        Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  imageAlt         String?
  imageSourceUrl   String?
  imageUrl         String?
  websiteUrl       String?
  admissionCutoffs AdmissionCutoff[]
  courses          Course[]
  placementStats   PlacementStats[]
  reviews          Review[]
  savedColleges    SavedCollege[]
  savedComparisons SavedComparisonCollege[]

  @@index([name])
  @@index([state])
  @@index([rating])
  @@index([totalFees])
}

model Course {
  id               String            @id @default(uuid())
  collegeId        String
  name             String
  duration         Int
  fees             Int
  seats            Int
  eligibility      String
  admissionCutoffs AdmissionCutoff[]
  college          College           @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model PlacementStats {
  id             String   @id @default(uuid())
  collegeId      String
  year           Int
  averagePackage Int
  highestPackage Int
  medianPackage  Int
  placementRate  Decimal  @db.Decimal(5, 2)
  topRecruiters  String[]
  college        College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([year])
}

model Review {
  id             String   @id @default(uuid())
  collegeId      String
  rating         Int
  title          String
  content        String
  author         String
  courseStudied  String
  graduationYear Int
  createdAt      DateTime @default(now())
  college        College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
}

model Exam {
  id               String            @id @default(uuid())
  name             String
  code             String            @unique
  description      String
  admissionCutoffs AdmissionCutoff[]
}

model AdmissionCutoff {
  id          String   @id @default(uuid())
  collegeId   String
  courseId    String
  examId      String
  year        Int
  openingRank Int
  closingRank Int
  category    Category
  college     College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  exam        Exam     @relation(fields: [examId], references: [id], onDelete: Cascade)

  @@index([examId])
  @@index([openingRank])
  @@index([closingRank])
  @@index([category])
}

enum CollegeType {
  GOVERNMENT
  PRIVATE
  DEEMED
}

enum Category {
  GENERAL
  OBC
  SC
  ST
  EWS
}

model User {
  id               String            @id @default(uuid())
  name             String
  email            String            @unique
  passwordHash     String
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  savedColleges    SavedCollege[]
  savedComparisons SavedComparison[]

  @@index([email])
}

model SavedCollege {
  id        String   @id @default(uuid())
  userId    String
  collegeId String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  college   College  @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([userId, collegeId])
  @@index([userId])
  @@index([collegeId])
}

model SavedComparison {
  id        String                   @id @default(uuid())
  userId    String
  title     String?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  user      User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  colleges  SavedComparisonCollege[]

  @@index([userId])
}

model SavedComparisonCollege {
  id           String          @id @default(uuid())
  comparisonId String
  collegeId    String
  order        Int             @default(0)
  comparison   SavedComparison @relation(fields: [comparisonId], references: [id], onDelete: Cascade)
  college      College         @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@unique([comparisonId, collegeId])
  @@index([comparisonId])
  @@index([collegeId])
}

