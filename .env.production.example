# Production Environment Variables
# Copy these to your Vercel Environment Variables settings

# Database (from Render)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="postgresql://user:password@hostname.render.com:5432/college_discovery"

# Authentication Secret (Generate a strong random string, minimum 32 characters)
# Generate using: PowerShell: -join ((48..57) + (65..90) + (97..122) | Get-Random -Count 32 | ForEach-Object {[char]$_})
AUTH_SECRET="your-super-secret-key-minimum-32-characters-long-random-string"

# Application Environment
NODE_ENV="production"

# Optional: Public App URL (auto-detected by Vercel, but can be set manually)
# NEXT_PUBLIC_APP_URL="https://your-domain.vercel.app"
